# Copy to tests/.env.testing and fill in. This file is gitignored.
#
# Integration tests run only when SNIPFORM_TEST_TOKEN is set. Without it,
# integration tests are skipped — unit tests always run.

SNIPFORM_TEST_BASE_URL=https://api.snipform.loc
SNIPFORM_TEST_TOKEN=
# Set to 0 if your local app uses a self-signed cert
SNIPFORM_TEST_VERIFY_SSL=0
