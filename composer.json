{
    "name": "snipform/php-sdk",
    "description": "Official PHP SDK for the Snipform API",
    "type": "library",
    "license": "MIT",
    "keywords": ["snipform", "sdk", "analytics", "signals", "tracking", "conversions"],
    "homepage": "https://snipform.io",
    "authors": [
        {
            "name": "David Philip",
            "email": "pd.philip@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/http-foundation": "^6.0|^7.0"
    },
    "require-dev": {
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "laravel/pint": "^1.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "illuminate/support": "Required for the optional Laravel service provider + session-id middleware in `SnipForm\\Laravel\\*`."
    },
    "extra": {
        "laravel": {
            "providers": [
                "SnipForm\\Laravel\\SnipFormServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "SnipForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SnipForm\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
